  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "HTTP Request Volume by Service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-pxloc"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-pxloc"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "HTTP p99 Server Response Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-pxloc"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-pxloc"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application))",
          "legendFormat": "{{application}} p99",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Error Rates (Non-2xx) by Service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-pxloc"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-pxloc"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{status!~\"2..\"}[1m])) by (application, status)",
          "legendFormat": "{{application}} - {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    }
  ],
