{
  "realm": "PolarBookshop",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Customer role for Polar Bookshop"
      },
      {
        "name": "employee",
        "description": "Employee role for Polar Bookshop"
      }
    ]
  },
  "clients": [
    {
      "clientId": "edge-service",
      "enabled": true,
      "clientAuthenticatorType": "none",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:9000/login/oauth2/code/keycloak",
        "https://*/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:9000",
        "https://*"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9000"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-to-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bjorn",
      "enabled": true,
      "firstName": "Bjorn",
      "lastName": "Vinterberg",
      "email": "bjorn@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bjorn",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [ "employee" ]
    },
    {
      "username": "isabelle",
      "enabled": true,
      "firstName": "Isabelle",
      "lastName": "Dahl",
      "email": "isabelle@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "isabelle",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [ "customer" ]
    }
  ]
}
